\@writefile{lot}{\contentsline {table}{\numberline {4}{\ignorespaces Controlled 6-Model Ablation Matrix for \textsc  {BifocalGemma}. All models use native Gemma~4 backbones with stream-isolated Per-Layer Embeddings ($d_{\text  {ple}}=256$) and preserve cross-layer KV-sharing (15/35 KV-owner layers in \texttt  {E2B}; 24/42 KV-owner layers in \texttt  {E4B}). Causal baselines use a single-stage full SFT curriculum, whereas \textsc  {BifocalGemma} variants use the two-stage paired curriculum (Frozen Decoder Bridge Alignment $\rightarrow $ Joint LoRA SFT).}}{7}{table.caption.14}\protected@file@percent }
