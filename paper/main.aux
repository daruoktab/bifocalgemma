\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces \textbf  {The BifocalGemma V3 Model Architecture.} Comprehensive bottom-to-top structural dataflow following the classic Transformer paradigm: (\textbf  {Left}) The Bidirectional Repository Encoder Stack ($N_{\text  {enc}} \le 32{,}768$) with stream-isolated Per-Layer Embeddings (PLE, $d_{\text  {ple}}=256$), unmasked self-attention across sliding and global heads, and final encoder RMSNorm; (\textbf  {Center-Top}) The SwiGLU Dual-Gate Coordinate Bridge ($\text  {SwiGLUDualGateBridge}$) with intermediate expansion $d_{\text  {mid}} = \max (d_{\text  {enc}}, d_{\text  {dec}})$, identity/orthogonal residual pathway $W_{\text  {res}}$, and per-channel scale calibration $\gamma _{\text  {calib}}$; (\textbf  {Center}) The $Z_{\text  {enc}}$ corridor highway conveying stationary Key/Value representations to decoder cross-attention; and (\textbf  {Right}) The Decoupled Causal Decoder Stack ($N_{\text  {dec}} \le 8{,}192$) with parallel decoupled cross-attention ($\Theta _{\text  {cross}}=0$) and causal self-attention, dual-gated head and token fusion, tied language model head, and logit softcapping.}}{3}{figure.caption.3}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{fig:architecture}{{1}{3}{\textbf {The BifocalGemma V3 Model Architecture.} Comprehensive bottom-to-top structural dataflow following the classic Transformer paradigm: (\textbf {Left}) The Bidirectional Repository Encoder Stack ($N_{\text {enc}} \le 32{,}768$) with stream-isolated Per-Layer Embeddings (PLE, $d_{\text {ple}}=256$), unmasked self-attention across sliding and global heads, and final encoder RMSNorm; (\textbf {Center-Top}) The SwiGLU Dual-Gate Coordinate Bridge ($\text {SwiGLUDualGateBridge}$) with intermediate expansion $d_{\text {mid}} = \max (d_{\text {enc}}, d_{\text {dec}})$, identity/orthogonal residual pathway $W_{\text {res}}$, and per-channel scale calibration $\gamma _{\text {calib}}$; (\textbf {Center}) The $Z_{\text {enc}}$ corridor highway conveying stationary Key/Value representations to decoder cross-attention; and (\textbf {Right}) The Decoupled Causal Decoder Stack ($N_{\text {dec}} \le 8{,}192$) with parallel decoupled cross-attention ($\Theta _{\text {cross}}=0$) and causal self-attention, dual-gated head and token fusion, tied language model head, and logit softcapping}{figure.caption.3}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {2.3}Decoupled Stationary Full-Rank Cross-Attention}{3}{subsection.2.3}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Preservation of Gemma~4 Cross-Layer KV-Sharing.}{3}{section*.6}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces Comprehensive Parameter Budgets and Allocation across the 6-Model Controlled Matrix. Bridge parameters include SwiGLU projections ($W_{\text  {gate}}, W_{\text  {up}}, W_{\text  {down}}$), residual routing $W_{\text  {res}}$ (identity for symmetric; $3.93\text  {M}$ orthogonal linear for asymmetric), norms, and per-channel calibration $\gamma _{\text  {calib}}$. Cross-attention parameters scale strictly with KV-owner layers ($15$ in \texttt  {E2B}; $24$ in \texttt  {E4B}). Stage~2 joint training activates LoRA ($r=16, \alpha =32$) on query/key/value/output linear weights, updating $<0.9\%$ of total model parameters.}}{4}{table.caption.4}\protected@file@percent }
\newlabel{tab:parameters}{{1}{4}{Comprehensive Parameter Budgets and Allocation across the 6-Model Controlled Matrix. Bridge parameters include SwiGLU projections ($W_{\text {gate}}, W_{\text {up}}, W_{\text {down}}$), residual routing $W_{\text {res}}$ (identity for symmetric; $3.93\text {M}$ orthogonal linear for asymmetric), norms, and per-channel calibration $\gamma _{\text {calib}}$. Cross-attention parameters scale strictly with KV-owner layers ($15$ in \texttt {E2B}; $24$ in \texttt {E4B}). Stage~2 joint training activates LoRA ($r=16, \alpha =32$) on query/key/value/output linear weights, updating $<0.9\%$ of total model parameters}{table.caption.4}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces \textbf  {Gemma~4 Cross-Layer KV-Sharing Topology in Decoupled Cross-Attention.} Structural layer allocation across the 35 layers of \texttt  {Gemma-4-E2B} (Panel~A) and 42 layers of \texttt  {Gemma-4-E4B} (Panel~B). Dedicated BF16 Cross-KV projections are instantiated exclusively on KV-owner layers ($15$ in \texttt  {E2B}; $24$ in \texttt  {E4B}). Subsequent KV-shared layers ($20$ in \texttt  {E2B}, $57.14\%$; $18$ in \texttt  {E4B}, $42.86\%$) reuse stationary $(K_{\text  {cross}}, V_{\text  {cross}})$ states computed by designated Anchor layers (\texttt  {L13}/\texttt  {L14} in \texttt  {E2B}; \texttt  {L22}/\texttt  {L23} in \texttt  {E4B}), reducing cross-attention KV-cache storage by up to $57.14\%$ with $\mathcal  {O}(1)$ step overhead.}}{4}{figure.caption.5}\protected@file@percent }
\newlabel{fig:layer_topology}{{2}{4}{\textbf {Gemma~4 Cross-Layer KV-Sharing Topology in Decoupled Cross-Attention.} Structural layer allocation across the 35 layers of \texttt {Gemma-4-E2B} (Panel~A) and 42 layers of \texttt {Gemma-4-E4B} (Panel~B). Dedicated BF16 Cross-KV projections are instantiated exclusively on KV-owner layers ($15$ in \texttt {E2B}; $24$ in \texttt {E4B}). Subsequent KV-shared layers ($20$ in \texttt {E2B}, $57.14\%$; $18$ in \texttt {E4B}, $42.86\%$) reuse stationary $(K_{\text {cross}}, V_{\text {cross}})$ states computed by designated Anchor layers (\texttt {L13}/\texttt {L14} in \texttt {E2B}; \texttt {L22}/\texttt {L23} in \texttt {E4B}), reducing cross-attention KV-cache storage by up to $57.14\%$ with $\mathcal {O}(1)$ step overhead}{figure.caption.5}{}}
\@writefile{toc}{\contentsline {paragraph}{Stationary Coordinate Invariance ($\Theta _{\text  {cross}} = 0$).}{4}{section*.8}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Critical Attention Length Scaling and Learnable Sharpness.}{4}{section*.9}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces Architectural Specifications and Cross-Layer KV-Sharing Topology for the \texttt  {Gemma~4} Backbone Stacks. In both encoder and decoder, only KV-owner layers instantiate independent key/value projections. For cross-attention, downstream KV-shared layers completely bypass Cross-KV projection, reusing cached states from designated Sliding and Global Anchor layers with $\mathcal  {O}(1)$ step overhead.}}{5}{table.caption.7}\protected@file@percent }
\newlabel{tab:layer_specs}{{2}{5}{Architectural Specifications and Cross-Layer KV-Sharing Topology for the \texttt {Gemma~4} Backbone Stacks. In both encoder and decoder, only KV-owner layers instantiate independent key/value projections. For cross-attention, downstream KV-shared layers completely bypass Cross-KV projection, reusing cached states from designated Sliding and Global Anchor layers with $\mathcal {O}(1)$ step overhead}{table.caption.7}{}}
